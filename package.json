{
  "name": "rafiki-chatbot-recordatorios",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run src api server",
    "firebase:emulators": "firebase emulators:start",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "npm run deploy:functions-core",
    "deploy:functions-core": "npm --prefix functions run build && firebase deploy --only functions:registerCurrentUser,functions:adminInviteEmail,functions:adminSetUserStatus",
    "deploy:functions-push": "npm --prefix functions run build && firebase deploy --only functions:dispatchDueReminders",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rafiki-061 \"vitest run tests/firestore.rules.test.ts\"",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.19.0",
    "firebase-tools": "^15.35.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.1.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "re2js": "^2.8.7"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
